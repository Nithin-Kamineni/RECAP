# Line endings: every text file is stored with LF and checked out with LF, on
# every platform. The shell scripts run inside Linux containers, and a CRLF
# makes bash fail with a mangled "invalid option name" error (see
# Energy_Modeling/tools-fix-eol.sh for the repair tool and the story).
* text=auto eol=lf

# Binary artefacts: never diff, never normalise.
*.png   binary
*.pdf   binary
*.pth   binary
*.pt    binary
*.sif   binary
*.pack  binary
*.idx   binary
