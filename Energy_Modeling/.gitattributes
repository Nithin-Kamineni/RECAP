# Shell scripts run inside a Linux container. A CRLF here makes bash read
# `pipefail\r` as an option name and fail with a mangled, self-overwriting
# error message (": invalid option namene 24: set: pipefail"). Force LF.
*.sh text eol=lf
*.py text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.json text eol=lf
