   "provenance": {
    "source_document": "Chen, Krishna, Emer, Sze, IEEE JSSC 52(1), 2017",
    "url": "https://eems.mit.edu/wp-content/uploads/2016/11/eyeriss_jssc_2017.pdf",
    "verified": "2026-09-06",
    "levels": {
     "DRAM": {
      "quote": "study-wide DRAM model, not from the paper",
      "note": "LPDDR4 64b word at 8b operands; identical for every design."
     },
     "ifmap_glb + psum_glb": {
      "quote": "\"The Eyeriss accelerator has a GLB of 108 kB ... 100 kB of the GLB is allocated for ifmaps and psums as required by the RS dataflow for reuse. ... the space is divided into 25 banks, each of which is a 512-b x 64-b (4 kB) SRAM. Each bank is assigned entirely to ifmaps or psums, and the assignment is reconfigurable\"",
      "modelled": "13 banks ifmap (52 kB) + 12 banks psum (48 kB) = the 100 kB",
      "approximation": "Timeloop has no dynamic repartitioning, so the reconfigurable 25-bank split is frozen at 13/12. Bank GEOMETRY (512 x 64b) is exact, which is what sets per-access energy; only the ifmap:psum ratio is fixed."
     },
     "filter_glb_8kB": {
      "quote": "\"Even though it is not required by the dataflow, the remaining 8 kB (two banks of 512-b x 64-b SRAMs) of the GLB is allocated for filter weights to compensate for insufficient off-chip traffic bandwidth.\"",
      "modelled": "NOT modelled as a reuse level (!Nothing on the Weights branch)",
      "rationale": "The paper is explicit that it is a prefetch buffer the RS dataflow does not need. Declaring it as a Timeloop storage level would hand v1 a full extra stage of weight reuse the dataflow does not actually have, which is exactly the quantity this study measures."
     },
     "weights_spad": {
      "quote": "The filter spad is implemented in a 224-b x 16-b SRAM due to its large size",
      "modelled": "depth 224, width 16, datawidth 8 -> 448 8-bit weights per PE"
     },
     "ifmap_spad": {
      "quote": "the ifmap and psum spads of size 12 b x 16 b and 24 b x 16 b, respectively, are implemented using registers",
      "modelled": "depth 12, width 16, datawidth 8 -> 24 8-bit iacts per PE"
     },
     "psum_spad": {
      "quote": "the ifmap and psum spads of size 12 b x 16 b and 24 b x 16 b",
      "modelled": "depth 24, width 16, datawidth 16 -> 24 psums at the accumulator width"
     },
     "mac": {
      "quote": "\"The computation consists of a 16-b two-stage pipelined multiplier and adder. Since the multiplication results are truncated from 32 to 16 b\"",
      "modelled": "multiplier_width 8 (study quantization), adder_width 16 (published)"
     },
     "PE_array": {
      "quote": "Sec. V-B describes a broadcast tag \"of the same size of the PE array (i.e., 168 b)\", fixing the array at 168 PEs.",
      "modelled": "meshX 14 x meshY 12 = 168 PEs"
     }
    }
