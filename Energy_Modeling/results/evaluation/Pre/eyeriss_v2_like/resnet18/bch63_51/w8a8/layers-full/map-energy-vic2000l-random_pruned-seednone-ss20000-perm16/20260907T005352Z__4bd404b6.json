    "levels": {
     "DRAM": {
      "quote": "study-wide DRAM model, not from the paper"
     },
     "iact_glb + psum_glb": {
      "quote": "Table IV: Global Buffer 192 KB (SRAM)",
      "modelled": "72 kB iact (48 banks) + 120 kB psum (64 banks) = 192 kB"
     },
     "weights_glb": {
      "modelled": "!Nothing -- weights have no GLB level in v2",
      "rationale": "Weights stream from DRAM through the weight routers into the PE spads. This is the single largest architectural difference from v1 in a weight-traffic study, so it is left as the paper describes it. The eyeriss_v2_like_wglb variant exists to bound what that costs."
     },
     "weights_spad": {
      "quote": "Table IV: weight data: 288B (SRAM); Fig. 17: 96 x 24b SRAM",
      "modelled": "depth 96, width 24, datawidth 8 -> 288 weights/PE, 55,296 on chip",
      "contested": "Sec. III-D (\"each count-data pair is 12b and is stored in a 12b word of the data SPad\") supports a CSC-native reading of 2 weights per 24b word = 192 weights/PE. The dense-bytes rule in standard.yaml gives 288. The difference is a third of v2's on-chip weight capacity and therefore materially changes its DRAM refetch; it is the largest single modelling judgement in the study. Recorded here so a reader can disagree with it."
     },
     "ifmap_spad": {
      "quote": "Table IV: iact data: 24B (Reg); Fig. 17: 16 x 12b Regs",
      "modelled": "depth 24, width 8, datawidth 8 -> 24 iacts/PE",
      "approximation": "Timeloop requires width % datawidth == 0 and the published word is 12b, which 8 does not divide. Modelled as 24 x 8b: same 24 B, same 24 operands, 24 narrow words instead of 16 wide ones. Per-access register energy is therefore for a narrower word than the design has. This is the only place in the study where a published word width cannot be declared as-is."
     },
     "psum_spad": {
      "quote": "Table IV: psum: 80B (Reg); Fig. 17: 32 x 20b Regs",
      "modelled": "depth 32, width 20, datawidth 20 -- exact"
     },
     "mac": {
      "quote": "Table IV: Arithmetic Precision: weights & iacts: 8b fixed-point / psums: 20b fixed-point",
      "modelled": "multiplier_width 8, adder_width 20"
     },
     "PE_array": {
      "quote": "Table IV: Number of PEs 192",
      "modelled": "16 PE clusters x 12 PEs, flattened from the physical 8x2 / 3x4"
     },
     "SIMD": {
      "quote": "Table V: # of MACs ... Eyeriss v2: 384",
      "modelled": "a 2-wide SIMD container under each PE (192 PEs x 2 = 384 MACs)"
     }
    }
   }
